@charset "utf-8";

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

body { margin: 0px; background: rgb(0, 0, 0); font-family: Arial, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; }

.calculator { width: 100%; max-width: 400px; padding: 20px; }

.display { height: 150px; color: white; font-size: 55px; display: flex; align-items: flex-end; justify-content: flex-end; padding: 10px; overflow: hidden; }

.buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }

button { border: 0px; height: 75px; border-radius: 50%; background: rgb(51, 51, 51); color: white; font-size: 26px; }

button:active { transform: scale(0.94); }

.gray { background: rgb(165, 165, 165); color: rgb(0, 0, 0); }

.orange { background: rgb(255, 149, 0); }

.zero { grid-column: span 2; border-radius: 40px; text-align: left; padding-left: 30px; }

.overlay { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.7); align-items: center; justify-content: center; padding: 20px; }

.popup { width: 100%; max-width: 350px; background: white; border-radius: 22px; padding: 22px; text-align: center; }

.popup h2 { margin-top: 0px; }

.package { border: 2px solid rgb(221, 221, 221); border-radius: 14px; padding: 15px; margin: 10px 0px; font-size: 17px; }

.package.selected { border-color: rgb(17, 17, 17); background: rgb(238, 238, 238); }

.pay { width: 100%; height: 50px; border-radius: 12px; background: rgb(17, 17, 17); color: white; margin-top: 8px; font-size: 17px; }

.cancel { background: rgb(221, 221, 221); color: rgb(17, 17, 17); }

#error { display: none; color: red; font-weight: bold; margin-top: 15px; }
